# Copie para .env.local e preencha. Nunca faça commit de valores reais.
DATABASE_URL=postgres://postgres@localhost:5433/nossafoto
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Armazenamento das fotos (Cloudflare R2). Sem estas variáveis, o desenvolvimento usa o disco em ./.storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nossafoto-fotos
# STORAGE_DRIVER=local    # força o disco local (testes com `next start`)
# LOCAL_STORAGE_DIR=      # pasta do disco local
# Serviço de rostos (Fly.io). Sem estas variáveis, a busca por selfie aparece como indisponível.
WORKER_URL=
WORKER_SECRET=
# Chave de API do Google (só Drive API). Lê pastas compartilhadas por link; não é OAuth.
GOOGLE_API_KEY=
